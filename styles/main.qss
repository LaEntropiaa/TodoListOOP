QMainWindow {
    background-color: #18181b;
}

QWidget {
    color: #eeeeee;
    font-size: 14px;
}

#main-title {
    font-size: 30px;
    font-weight: bold;
}

#login-container {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 16px;
    padding: 30px;
    min-width: 320px;
}

#login-title {
    font-size: 30px;
    font-weight: bold;
}

#login-subtitle {
    color: #a1a1aa;
    font-size: 16px;
}

QLineEdit,
QTextEdit,
QDateEdit {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 9px;
}

QLineEdit:focus,
QTextEdit:focus,
QDateEdit:focus {
    border: 1px solid #71717a;
}

QPushButton {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    padding: 9px 14px;
}

QPushButton:hover {
    background-color: #3f3f46;
}

QPushButton:pressed {
    background-color: #52525b;
}

#primary-button {
    background-color: #52525b;
    font-weight: bold;
}

#primary-button:hover {
    background-color: #71717a;
}

#logout-button {
    padding: 7px 12px;
}

QWidget[listType="Inbox"] {
    background-color: #25252a;
    border: 1px solid #3f3f46;
    border-radius: 12px;
}

QWidget[listType="Todo"] {
    background-color: #242a25;
    border: 1px solid #3f4a40;
    border-radius: 12px;
}

QWidget[listType="Due"] {
    background-color: #302727;
    border: 1px solid #503939;
    border-radius: 12px;
}

QWidget[listType="Completed"] {
    background-color: #25282d;
    border: 1px solid #3d444d;
    border-radius: 12px;
}

QLabel#list-title {
    background: transparent;
    border: none;
    font-size: 18px;
    font-weight: bold;
    padding: 4px;
}

QFrame#task {
    background-color: rgba(20, 20, 23, 180);
    border: 1px solid #3f3f46;
    border-radius: 9px;
    text-align: left;
}

QFrame#task:hover {
    background-color: #323238;
    border: 1px solid #71717a;
}

QLabel#task-title {
    background: transparent;
    border: none;
    font-size: 15px;
    font-weight: bold;
}

QLabel#task-description {
    background: transparent;
    border: none;
    color: #a1a1aa;
}

QLabel#task-date {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-size: 12px;
}

#add-task {
    background-color: transparent;
    border: 1px dashed #52525b;
}

#add-task:hover {
    background-color: #323238;
}
